<?xml version="1.0" encoding="utf-8"?>
<!--
  The Room database is EXCLUDED on purpose.

  Copying a live SQLite file with WAL enabled produces a corrupt database on restore, and
  "you never lose your configuration" is one of the app's selling points. The user-facing
  backup path is the JSON export, which is a consistent snapshot by construction.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
